# ── MongoDB Atlas ──────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>
DATABASE_NAME=rentsaathi

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Resend Email  ──────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=RentSaathi <noreply@yourdomain.resend.dev>

# ── Frontend / CORS ───────────────────────────────────────────────
# Primary frontend origin (used as default CORS allow_origin)
#  - Local dev:    http://localhost:5173
#  - Production:   https://rent-sathi-xi.vercel.app
FRONTEND_URL=http://localhost:5173
# Comma-separated additional origins (staging, preview, etc.)
# ALLOWED_ORIGINS=https://rentsaathi.in,https://www.rentsaathi.in

# ── ClamAV ──────────────────────────────────────────────────────────
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ── Redis ───────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── Sentry ──────────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.xxx/xxx

# ── Environment ───────────────────────────────────────────────────
ENVIRONMENT=development
